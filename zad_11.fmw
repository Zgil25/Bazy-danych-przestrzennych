O" "ContentDate<solidus>Start<space>gt<space><at>DateTimeFormat<openparen>$($(SentinelDownloader_WORKSPACE_NAME)_BEGIN$encode)<comma>%Y-%m-%d<closeparen>T00:00:00.000Z<space>and<space>ContentDate<solidus>Start<space>lt<space><at>DateTimeFormat<openparen><at>Value<openparen>end_date<closeparen><comma>%Y-%m-%d<closeparen>T00:00:00.000Z" "varchar<openparen>200<closeparen>" }      ATTR_ACTION { "" "location" "SET_TO" "OData.CSC.Intersects<openparen>area=geography%27SRID=4326<semicolon>POINT<openparen><at>Value<openparen>lon<closeparen>%20<at>Value<openparen>lat<closeparen><closeparen>%27<closeparen>" "varchar<openparen>200<closeparen>" }      ATTR_ACTION { "" "url" "SET_TO" "<at>Value<openparen>base_url_S2<closeparen><at>Value<openparen>cloud_cover<closeparen><space>and<space><at>Value<openparen>productType<closeparen><space>and<space><at>Value<openparen>daterange<closeparen><space>and<space><at>Value<openparen>location<closeparen><amp><dollar>orderby=ContentDate<solidus>Start<space>desc" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeCreator_OUTPUT"        }
# -------------------------------------------------------------------------
# check if we have to do the min bounding box calculation
INCLUDE [    if { {BB} == {MINBB} } {       puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Force2D() @Bounds(fme_encoded,MIN_BOUNDING,,,<Unused>)};    } elseif { {BB} == {BB} } {       puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Force2D() @Bounds(fme_encoded,BOUNDING_BOX_AXIS_ALIGNED,,)};    } else {       puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Bounds(fme_encoded,BOUNDING_CUBE,,)};    } ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_GeometryFilter_Area"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BOX"         $($(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc)          }
