# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_LIST_FUNC }    } else {        puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_6_PASSED"    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeCreator_3_OUTPUT"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_OUTPUT"        @RemoveAttributes(fme_encoded,_END,_geometry,_LEVEL)        $($(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_LIST_FUNC)         }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(SentinelDownloader_WORKSPACE_NAME)_Logger_7_2ed535a7_7ccb_4015_b402_1e4bce0b522c3} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME $(SentinelDownloader_WORKSPACE_NAME)_Logger_7
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Logger_7_Logger }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_OUTPUT"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_7_LOGGED"                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,HTTP<space>request<space>against<space><at>Value<openparen>url<closeparen><space>...,$(SentinelDownloader_WORKSPACE_NAME)_Logger_7)","<Unused>","20","",INFO,NONE,$(FME_UUID_SAFE))                   }
# -------------------------------------------------------------------------
# Combine the two "file path attribute" parameters into one value.
DEFAULT_MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_FILE_PATH_ATTR
INCLUDE [ 	if { {<Unused>} == {<Unused>} } { 		puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_FILE_PATH_ATTR "<Unused>"}; 	} else { 		puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_FILE_PATH_ATTR "<Unused>"}; 	} ]
