FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection Input Input Collector"   INPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"   OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection_Input"
MACRO ResolveWebConnection_WORKSPACE_NAME $(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection
MACRO $(ResolveWebConnection_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(ResolveWebConnection_WORKSPACE_NAME)_XFORMER_NAME $(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection
MACRO $(ResolveWebConnection_WORKSPACE_NAME)___COMPOUND_PARAMETERS 
MACRO $(ResolveWebConnection_WORKSPACE_NAME)_WEB_CONNECTION @Value(_WEB_CON)
MACRO $(ResolveWebConnection_WORKSPACE_NAME)_SUB_DOC_NAME ResolveWebConnection
MACRO $(ResolveWebConnection_WORKSPACE_NAME)_SUB_DOC_NAME ResolveWebConnection
DEFAULT_MACRO ResolveWebConnection_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(ResolveWebConnection_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(ResolveWebConnection_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(ResolveWebConnection_WORKSPACE_NAME)_Input1769113197 Input Splitter"   INPUT FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_Input"   OUTPUT FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_Input"
# -------------------------------------------------------------------------
Tcl2 proc $(ResolveWebConnection_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"_WEB_CONNECTION {$($(ResolveWebConnection_WORKSPACE_NAME)_WEB_CONNECTION$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(ResolveWebConnection_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(ResolveWebConnection_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ResolveWebConnection_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_Input"    OUTPUT { FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(ResolveWebConnection_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
