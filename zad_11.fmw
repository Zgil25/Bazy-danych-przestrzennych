FACTORY_DEF {*} TestFactory FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2 } INPUT FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2_All TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS_10$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B2_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B3_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B4_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_TCI_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B8_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = R10m ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "( 1 OR 2 OR 3 OR 4 OR 5 OR 6 ) AND 7" OUTPUT PASSED_1 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2_10m TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS_20$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B2_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B3_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B4_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B5_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B6_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B7_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B8_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B11_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B12_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_TCI_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = R20m ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "( 1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 OR 10 OR 11 ) AND 12" OUTPUT PASSED_2 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2_20m TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS_60$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B1_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B2_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B3_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B4_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B5_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B6_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B7_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B8_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B9_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B11_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B12_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_TCI_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = R60m ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "( 1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 OR 10 OR 11 OR 12 OR 13 ) AND 14" OUTPUT PASSED_3 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2_60m OUTPUT FAILED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2_<lt>UNFILTERED<gt>
