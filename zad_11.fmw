# -------------------------------------------------------------------------
Tcl2 proc Creator_CoordSysRemover {} {   global FME_CoordSys;   set FME_CoordSys {}; }
MACRO Creator_XML     NOT_ACTIVATED
MACRO Creator_GEOJSON NOT_ACTIVATED
INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO Creator_XML *} } ]
INCLUDE [ if { {Geometry Object} == {GeoJSON} } {            puts {MACRO Creator_GEOJSON *} } ]
FACTORY_DEF {$(Creator_XML)} CreationFactory    FACTORY_NAME { Creator_XML_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______        @Geometry(FROM_ENCODED_STRING,<lt>?xml<space>version=<quote>1.0<quote><space>encoding=<quote>UTF-8<quote><space>standalone=<quote>no<quote><space>?<gt><lt>geometry<gt><lt>null<solidus><gt><lt><solidus>geometry<gt>) }
FACTORY_DEF {$(Creator_GEOJSON)} CreationFactory    FACTORY_NAME { Creator_GEOJSON_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______ 	   @SupplyAttributes(ENCODED,__GeoJSONCreatorTemp__,<Unused>)        @JSONGeometry(FROM_ATTRIBUTE,GEOJSON,__GeoJSONCreatorTemp__, PREFER_ERROR_OVER_REJECTION) 	   @RemoveAttributes(__GeoJSONCreatorTemp__) }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Creator_Cloner }    INPUT FEATURE_TYPE _____CREATED______        @Tcl2(Creator_CoordSysRemover)        @CoordSys()    NUMBER_OF_COPIES { 1 }    COPY_NUMBER_ATTRIBUTE { "_creation_instance" }    OUTPUT { FEATURE_TYPE Creator_CREATED        fme_feature_type Creator         }
FACTORY_DEF * BranchingFactory   FACTORY_NAME "Creator_CREATED Brancher -1 4"   INPUT FEATURE_TYPE Creator_CREATED   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   INPUT FEATURE_TYPE *  OUTPUT FEATURE_TYPE *
# -------------------------------------------------------------------------
FME_PYTHON_PATH "$(FME_MF_DIR)"
FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { PythonCaller_Creator }    OUTPUT { FEATURE_TYPE PythonCaller_____CREATED______ }
FACTORY_DEF {*} PythonFactory    FACTORY_NAME { PythonCaller }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT { FEATURE_TYPE PythonCaller_____CREATED______ }    INPUT  FEATURE_TYPE Creator_CREATED    SYMBOL_NAME { FeatureProcessor }    SOURCE_CODE { import<space>fme<lf>import<space>fmeobjects<lf>import<space>smtplib<lf>from<space>email.mime.text<space>import<space>MIMEText<lf>from<space>datetime<space>import<space>datetime<lf><lf>def<space>FeatureProcessor<openparen>feature<closeparen>:<lf><lf><space><space><space><space>sender<space>=<space>fme.macroValues.get<openparen><apos>email_sender<apos><closeparen><lf><space><space><space><space>password<space>=<space>fme.macroValues.get<openparen><apos>email_password<apos><closeparen><lf><space><space><space><space>receiver<space>=<space>fme.macroValues.get<openparen><apos>email_client<apos><closeparen><lf><space><space><space><space>powiat<space>=<space>fme.macroValues.get<openparen><apos>powiat_name<apos><closeparen><lf><space><space><space><space><lf><lf><space><space><space><space>czas_startu<space>=<space>datetime.now<openparen><closeparen>.strftime<openparen><quote>%Y-%m-%d<space>%H:%M:%S<quote><closeparen><lf><space><space><space><space>body<space>=<space>f<quote>Drogi<space>u<u017c>ytkowniku<space><opencurly>receiver<closecurly><comma><space>o<space>godzinie<space><opencurly>czas_startu<closecurly><space>rozpocz<u0119>to<space>przetwarzanie<space>danych<space>dla<space>gminy<space><opencurly>powiat<closecurly><quote><lf><space><space><space><space><lf><space><space><space><space>msg<space>=<space>MIMEText<openparen>body<closeparen><lf><space><space><space><space>msg<openbracket><apos>Subject<apos><closebracket><space>=<space><quote>FME:<space>Rozpocz<u0119>cie<space>przetwarzania<quote><lf><space><space><space><space>msg<openbracket><apos>From<apos><closebracket><space>=<space>sender<lf><space><space><space><space>msg<openbracket><apos>To<apos><closebracket><space>=<space>receiver<lf><lf><lf><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space>server<space>=<space>smtplib.SMTP_SSL<openparen><apos>smtp.gmail.com<apos><comma><space>465<closeparen><lf><space><space><space><space><space><space><space><space>server.login<openparen>sender<comma><space>password<closeparen><lf><space><space><space><space><space><space><space><space>server.send_message<openparen>msg<closeparen><lf><space><space><space><space><space><space><space><space>server.quit<openparen><closeparen><lf><space><space><space><space>except<space>Exception<space>as<space>e:<lf><space><space><space><space><space><space><space><space><space>print<openparen>f<quote>B<u0142><u0105>d<space>wysy<u0142>ki<space>maila:<space><opencurly>e<closecurly><quote><closeparen> }    PY_OUTPUT_TAGS { PYOUTPUT <Rejected> }    OUTPUT { PYOUTPUT FEATURE_TYPE PythonCaller_OUTPUT         }    OUTPUT { <Rejected> FEATURE_TYPE PythonCaller_<Rejected>         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "PythonCaller OUTPUT Transformer Output Nuker"   INPUT FEATURE_TYPE PythonCaller_OUTPUT
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME PythonCaller_<Rejected> INPUT FEATURE_TYPE PythonCaller_<Rejected>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, PythonCaller<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester }    INPUT  FEATURE_TYPE A02_Granice_powiatow_SHAPEFILE_1    CASE_SENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>JPT_NAZWA_<closeparen>,Tester)" CONTAINS_REGEX "@EvaluateExpression(FDIV,STRING_ENCODED,<openparen>?i<closeparen>$(powiat_name$encode),Tester)" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_PASSED         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector }    INPUT  FEATURE_TYPE Tester_PASSED    ENGINE { SOURCE "" DESTINATION "EPSG:4326" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_REPROJECTED          }    OUTPUT { REJECTED FEATURE_TYPE Reprojector_<REJECTED>          }
