FME_PYTHON_PATH "$(FME_MF_DIR)"
FACTORY_DEF {*} PythonFactory    FACTORY_NAME { $(ResolveWebConnection_WORKSPACE_NAME)_PythonCaller }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT  FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"    SYMBOL_NAME { FeatureProcessor }    SOURCE_CODE { import<space>fme<lf>import<space>fmeobjects<lf>from<space>fmeobjects<space>import<space>FMEException<lf>from<space>fmewebservices<space>import<space>FMENamedConnectionManager<lf><lf>class<space>FeatureProcessor<openparen>object<closeparen>:<lf><space><space><space><space>def<space>__init__<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>pass<lf><lf><space><space><space><space>def<space>input<openparen>self<comma><space>feature<closeparen>:<lf><space><space><space><space><space><space><space><space>conn_name<space>=<space>feature.getAttribute<openparen><apos>_WEB_CONNECTION<apos><closeparen><lf><space><space><space><space><space><space><space><space>conn<space>=<space>self.get_connection<openparen>conn_name<closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><quote>username<quote><comma><space>conn.getUserName<openparen><closeparen><closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><quote>password<quote><comma><space>conn.getPassword<openparen><closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><lf><space><space><space><space><space><space><space><space>self.pyoutput<openparen>feature<closeparen><lf><lf><space><space><space><space>def<space>close<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>pass<lf><space><space><space><space>def<space>get_connection<openparen>self<comma><space>conn_name<closeparen>:<lf><space><space><space><space><space><space><space><space><quote><quote><quote>Given<space>the<space>name<space>of<space>a<space>Named<space>Connection<comma><space>return<space>its<space>object.<quote><quote><quote><lf><space><space><space><space><space><space><space><space>#<space>TODO:<space>Log<space>messages<comma><space>including<space>user-facing<space>exception<space>messages<comma><lf><space><space><space><space><space><space><space><space>#<space><space>should<space>be<space>prefixed<space>by<space>the<space>transformer<space>name.<lf><space><space><space><space><space><space><space><space>if<space>not<space>conn_name:<lf><space><space><space><space><space><space><space><space><space><space><space><space>raise<space>FMEException<openparen><quote>Connection<space>must<space>be<space>specified<quote><closeparen><lf><space><space><space><space><space><space><space><space>conn<space>=<space>FMENamedConnectionManager<openparen><closeparen>.getNamedConnection<openparen>conn_name<closeparen><lf><space><space><space><space><space><space><space><space>if<space>not<space>conn:<lf><space><space><space><space><space><space><space><space><space><space><space><space>raise<space>FMEException<openparen><quote>Connection<space>does<space>not<space>exist<quote><closeparen><lf><space><space><space><space><space><space><space><space>return<space>conn<lf> }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_PythonCaller_OUTPUT"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(ResolveWebConnection_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(ResolveWebConnection_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ResolveWebConnection_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_PythonCaller_OUTPUT"    OUTPUT { FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,_WEB_CONNECTION)        $($(ResolveWebConnection_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(ResolveWebConnection_WORKSPACE_NAME)_Output1769113197 Output Collector"   INPUT FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(ResolveWebConnection_WORKSPACE_NAME)_Output"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(ResolveWebConnection_WORKSPACE_NAME))}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection Output Output Renamer/Nuker"   INPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection_Output"   OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection_Output"
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeCreator_2 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ResolveWebConnection_Output"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "enc" "SET_TO" "grant_type=client_credentials<amp>client_id=<at>Value<openparen>username<closeparen><amp>client_secret=<at>Value<openparen>password<closeparen>" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeCreator_2_OUTPUT"        }
