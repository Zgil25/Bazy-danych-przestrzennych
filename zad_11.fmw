FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_2 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_OUTPUT"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_2_OUTPUT"         @Tcl2($(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_2_doFetch)          }
