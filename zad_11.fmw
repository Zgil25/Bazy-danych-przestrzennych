MACRO $(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_TRANSFORMATION
# Only pass on transformation if a source coordinate system was picked
INCLUDE [    if { {} != {} } {       puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_TRANSFORMATION <Unused>};    }; ]
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Initiator"    ENGINE { ENGINE_NAME FME         SOURCE ""         DESTINATION "LL-WGS84"         VERTICAL_HANDLING <Unused>         GEOID_HEIGHT_GRID "<Unused>"         TRANSFORMATION "$($(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_TRANSFORMATION)" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { 0.0 }    OUTPUT { REPROJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_REPROJECTED"          }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_<REJECTED>"          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME "$(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_<Rejected>" INPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_<REJECTED>"  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, SentinelDownloader_CsmapReprojector<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
Tcl2 proc $(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"_WEB_CON {$($(SentinelDownloader_WORKSPACE_NAME)_WEB_CON$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CsmapReprojector_REPROJECTED"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
