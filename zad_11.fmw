FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { Emailer_Creator }    OUTPUT { FEATURE_TYPE Emailer_____CREATED______ }
# Note -- the AttachmentTable has to have a SPACE as the first character so that we don't get the *bad*
# FME Parser to start parsing a @ function call -- if @ is the first character, it will, and then we lose
# our table elements :-(
# The python later expects the first character to be a space so all is well.
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Emailer_CATCHER }    INPUT { FEATURE_TYPE Emailer_____CREATED______ }    INPUT  FEATURE_TYPE DateTimeConverter_OUTPUT    OUTPUT { FEATURE_TYPE Emailer_READY       @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)       ___fme_emailer_service           "Generic SMTP"       ___fme_emailer_connection        "HOST;smtp.gmail.com;PORT;587;ENCRYPTION;TLS;TIMEOUT_Generic_SMTP;60;AUTHENTICATION;YES;USERNAME;@EvaluateExpression(FDIV,STRING_ENCODED,$(email_sender$encode),Emailer);PASSWORD;@EvaluateExpression(FDIV,STRING_ENCODED,$(email_password$encode),Emailer);TIMEOUT;60"       ___fme_emailer_from              "@EvaluateExpression(FDIV,STRING_ENCODED,$(email_sender$encode),Emailer)"       ___fme_emailer_to                "@EvaluateExpression(FDIV,STRING_ENCODED,$(email_client$encode),Emailer)"       ___fme_emailer_cc                ""       ___fme_emailer_bcc               ""       ___fme_emailer_subject           "@EvaluateExpression(FDIV,STRING_ENCODED,Raport<space>NDVI<space>dla<space>powiatu<space>$(powiat_name$encode),Emailer)"       ___fme_emailer_body              "@EvaluateExpression(FDIV,STRING_ENCODED,data:<space><at>Value<openparen>_timestamp<closeparen><lf><u015b>rednia<space>NDVI:<space><at>Value<openparen>band0.mean<closeparen><lf>odchylenie<space>standardowe:<space><at>Value<openparen>band0.stdev<closeparen>,Emailer)"       ___fme_emailer_attachments       " "       ___fme_emailer_xformerName       "Emailer"       ___fme_emailer_headers           " "   }
FACTORY_DEF {*} PythonFactory    FACTORY_NAME { Emailer_CALLER }    INPUT { FEATURE_TYPE Emailer_READY }    PYTHON_NAMESPACE FMEOBJECTS    SYMBOL_NAME fmepy_emailer.Emailer    OUTPUT { PYOUTPUT FEATURE_TYPE Emailer_PROCESSED     @RemoveAttributes(INPUT_PORT_CONNECTED) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Emailer_ROUTER }    INPUT { FEATURE_TYPE Emailer_PROCESSED }    TEST &fme_rejection_code == ""    OUTPUT { FAILED FEATURE_TYPE Emailer_<REJECTED>       @RemoveAttributes(___fme_rejection_code___)        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME Emailer_<Rejected> INPUT FEATURE_TYPE Emailer_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, Emailer<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
