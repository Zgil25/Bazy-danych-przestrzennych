INCLUDE [ if {{$(email_sender$encode)} == {}} { puts_real {Parameter 'email_sender' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(email_password$encode)} == {}} { puts_real {Parameter 'email_password' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(email_client$encode)} == {}} { puts_real {Parameter 'email_client' must be given a value.}; exit 1; }; ]
