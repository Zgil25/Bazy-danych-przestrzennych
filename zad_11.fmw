INCLUDE [    set supplyXFunc {};    if { {lon} != {} }    {       set supplyXFunc {@Coordinate(REJECTABLE,x,"0",FLATTEN_AGGREGATE,YES)};    };    puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_X ${supplyXFunc}"; ]
INCLUDE [    set supplyYFunc {};    if { {lat} != {} }    {       set supplyYFunc {@Coordinate(REJECTABLE,y,"0",FLATTEN_AGGREGATE,NO)};    };    puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Y ${supplyYFunc}"; ]
INCLUDE [    set supplyZDefaultFunc {};    if { {} != {} }    {       set supplyZDefaultFunc {@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING,"",,FLOAT)};    };    puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Z_DEFAULT ${supplyZDefaultFunc}"; ]
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_TESTZDEFAULT }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Reprojector_REPROJECTED"    TEST { "" = "" ENCODED }    TEST { "" TYPE NUM ENCODED }    BOOLEAN_OPERATOR OR    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { PASSED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_TESTMODE_INPUT }    OUTPUT { FAILED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"       @SupplyAttributes(fme_rejection_code, INVALID_PARAMETER_DEFAULT_Z)        }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_TESTMODE }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_TESTMODE_INPUT }    TEST { "Specify Coordinate" == "All Coordinates" }    OUTPUT { PASSED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_LIST_INPUT }    OUTPUT { FAILED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_INPUT }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_LIST }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_LIST_INPUT }    TEST @Dimension() == 2    OUTPUT { PASSED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"         @ZValue("")         @Coordinate(x,ALL,"<Unused>"{}.x,FLATTEN_AGGREGATE,YES)         @Coordinate(y,ALL,"<Unused>"{}.y,FLATTEN_AGGREGATE,NO)         @Coordinate(z,ALL,"<Unused>"{}.z,FLATTEN_AGGREGATE,NO)         @Dimension(2)          }    OUTPUT { FAILED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"         @Coordinate(x,ALL,"<Unused>"{}.x,FLATTEN_AGGREGATE,YES)         @Coordinate(y,ALL,"<Unused>"{}.y,FLATTEN_AGGREGATE,NO)         @Coordinate(z,ALL,"<Unused>"{}.z,FLATTEN_AGGREGATE,NO)          }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_INPUT }    TEST { "0" TYPE INT ENCODED }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { PASSED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_X_INPUT }    OUTPUT { FAILED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"       @SupplyAttributes(fme_rejection_code, INVALID_PARAMETER_INDEX)        }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_X }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_X_INPUT }    FUNCTION_DEFINITION { $($(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_X) }    RESULT_ATTRIBUTE { "lon" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y_INPUT }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Y_INPUT }    FUNCTION_DEFINITION { $($(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Y) }    RESULT_ATTRIBUTE { "lat" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER_INPUT }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_ROUTER_INPUT }    TEST { "" != "" ENCODED }    TEST @Dimension() == 3    BOOLEAN_OPERATOR AND    OUTPUT { PASSED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_INPUT }    OUTPUT { FAILED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"       $($(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SUPPLY_Z_DEFAULT)        }
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_INPUT }    FUNCTION_DEFINITION { @Coordinate(REJECTABLE,z,"0",FLATTEN_AGGREGATE,NO) }    RESULT_ATTRIBUTE { "" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
