FACTORY_DEF {*} RasterEvaluationFactory    FACTORY_NAME { NDVI }    INPUT A FEATURE_TYPE Sampler_B04_SAMPLED    INPUT B FEATURE_TYPE Sampler_B08_SAMPLED    INTERPRETATION_LIST "REAL32" EXPRESSION_LIST "<openparen>1.0<space>*<space><openparen>B<openbracket>0<closebracket><space>-<space>A<openbracket>0<closebracket><closeparen><closeparen><space><solidus><space><openparen>B<openbracket>0<closebracket><space>+<space>A<openbracket>0<closebracket><closeparen>"    FORCE_FLOAT_DIVISION yes    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    ATTRIBUTE_ACCUMULATION_MODE { MERGE }    ATTRIBUTE_CONFLICT_RESOLUTION { PREFER_B }    REJECT_INVALID_FEATURES YES    OUTPUT { RESULT FEATURE_TYPE NDVI_RESULT          }    OUTPUT { <REJECTED> FEATURE_TYPE NDVI_<REJECTED>          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
