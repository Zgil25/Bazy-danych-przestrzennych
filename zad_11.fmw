ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_11 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B11 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B12 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_12 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B12 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX TCI ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_13 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_TCI OUTPUT FAILED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_<lt>UNFILTERED<gt>
