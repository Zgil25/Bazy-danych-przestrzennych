FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Tester_4 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_3_FRAGMENTS"    CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_Tester_4)" NOT_CONTAINS _AOT_ ENCODED } CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_Tester_4)" NOT_CONTAINS _WVP_ ENCODED } CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_Tester_4)" NOT_CONTAINS _SCL_ ENCODED }    BOOLEAN_OPERATOR { COMPOSITE }    COMPOSITE_TEST_EXPR { "1 AND 2 AND 3" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_4_PASSED"         }
