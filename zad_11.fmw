DEFAULT_MACRO email_sender testfme97@gmail.com

DEFAULT_MACRO email_password fme_decrypt()

DEFAULT_MACRO email_client zoskagil@gmail.com

DEFAULT_MACRO powiat_name zabrze

DEFAULT_MACRO cloud_coverage 20

DEFAULT_MACRO date_start 20251230000000

DEFAULT_MACRO date_end 20260116000000

DEFAULT_MACRO SourceDataset_SHAPEFILE $(FME_MF_DIR)00_jednostki_administracyjne\A02_Granice_powiatow.shp

